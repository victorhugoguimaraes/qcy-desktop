{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QCY Desktop",
  "version": "0.3.0",
  "identifier": "io.qcydesktop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run check:release",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QCY Desktop",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Controle Bluetooth para QCY MeloBuds N50",
    "longDescription": "Controle de ANC, bateria e equalizador para QCY MeloBuds N50."
  }
}
