{
  "name": "qcy-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "install:linux": "bash scripts/install-linux.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "node scripts/test-rust.mjs",
    "check": "npm test && npm run test:rust && npm run build",
    "test:ui": "playwright test",
    "test:memory": "python3 scripts/memory-profile.py",
    "check:release": "npm run check && npm run test:ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
